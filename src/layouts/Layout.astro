---
import { CLUB_CONFIG } from '../config/club.config';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = `Arhiva oficială a competițiilor organizate de ${CLUB_CONFIG.numeComplet}.`,
} = Astro.props;
---

<html lang="ro">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
</head>
<body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col font-sans">
  <slot />
</body>
</html>

---
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import { CLUB_CONFIG } from '../../../config/club.config';
import { CompetitionService } from '../../../services/competition.service';
import { MediaService } from '../../../services/media.service';

const id = Number(Astro.params.id);
if (!id) return Astro.redirect('/admin');

let feedback = { type: '', message: '' };

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = String(formData.get('action') || '');
    const comp = await CompetitionService.getCompetitionById(id);
    if (!comp) return Astro.redirect('/admin');

    if (action === 'import_csv') {
      const csvText = String(formData.get('csvContent') || '').trim();
      if (!csvText) {
        feedback = { type: 'error', message: 'Lipește conținutul CSV înainte de import.' };
      } else {
        const count = await CompetitionService.importResultsFromCsv(id, csvText);
        feedback = { type: 'success', message: `Au fost importați/actualizați ${count} participanți.` };
      }
    }
if (action === 'save_cumulative') {
  const rulesRaw = String(formData.get('cumulativeRulesJson') || '').trim();
  if (rulesRaw) {
    JSON.parse(rulesRaw); // validează că este JSON corect
  }
  await CompetitionService.updateCompetition(id, {
    cumulativeRulesJson: rulesRaw || null,
  });
  feedback = { type: 'success', message: 'Regulile de clasament cumulat au fost salvate.' };
}

    if (action === 'upload_assets') {
      const updates: Record<string, any> = {};
      const kmzFile = formData.get('kmzFile') as File | null;
      const mapImage = formData.get('mapImage') as File | null;
      const pdfFile = formData.get('regulationsPdf') as File | null;
      const posterFile = formData.get('posterImage') as File | null;
      const diplomaFile = formData.get('diplomaTemplate') as File | null;
      const cornersRaw = String(formData.get('mapCornersJson') || '').trim();

      if (kmzFile && kmzFile.size > 0) {
        updates.kmzFilePath = await MediaService.saveDocument(kmzFile, comp.slug, 'harta-oficiala');
        updates.mapSourceType = 'kmz';
      }
      if (mapImage && mapImage.size > 0) {
        updates.mapImagePath = await MediaService.saveDocument(mapImage, comp.slug, 'harta-scanata');
        if (!updates.mapSourceType) updates.mapSourceType = 'image';
      }
      if (cornersRaw) updates.mapCornersJson = cornersRaw;
      if (pdfFile && pdfFile.size > 0) {
        updates.regulationsPdfPath = await MediaService.saveDocument(pdfFile, comp.slug, 'regulament');
      }
      if (posterFile && posterFile.size > 0) {
        updates.posterImagePath = await MediaService.saveDocument(posterFile, comp.slug, 'afis');
      }
      if (diplomaFile && diplomaFile.size > 0) {
        updates.diplomaTemplatePath = await MediaService.saveDocument(diplomaFile, comp.slug, 'diploma');
      }

      await CompetitionService.updateCompetition(id, updates);
      feedback = { type: 'success', message: 'Documentele și harta competiției au fost salvate.' };
    }

    if (action === 'upload_photos') {
      const files = formData.getAll('photos') as File[];
      const photoCategory = (String(formData.get('photoCategory') || 'atmosfera') as any);
      const isFeatured = formData.get('isFeatured') === 'on';
      let savedCount = 0;

      for (const file of files) {
        if (file && file.size > 0) {
          await MediaService.saveEventPhoto(file, {
            competitionId: id,
            competitionSlug: comp.slug,
            photoCategory,
            isFeatured,
          });
          savedCount++;
        }
      }
      feedback = { type: 'success', message: `${savedCount} fotografii procesate și adăugate în arhivă.` };
    }
  } catch (err: any) {
    feedback = { type: 'error', message: err?.message || 'A apărut o eroare la procesare.' };
  }
}

const competition = await CompetitionService.getCompetitionById(id);
if (!competition) return Astro.redirect('/admin');
---
<Layout title={`Gestionează: ${competition.title} | Admin`}>
  <header class="bg-slate-950 text-white border-b border-slate-800">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-4 flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <a href="/admin" class="text-xs font-semibold text-slate-300 hover:text-white">&larr; Dashboard</a>
        <span class="text-slate-600">|</span>
        <h1 class="font-bold text-sm sm:text-base">{competition.title} ({competition.date})</h1>
      </div>

      <div class="flex items-center gap-2 text-xs">
        <a href={`/concurs/${competition.slug}`} target="_blank" class="px-3 py-1.5 rounded bg-slate-800 hover:bg-slate-700">
          Pagină Publică &nearr;
        </a>
        <a href={`/admin/print/${competition.id}`} target="_blank" class="px-3 py-1.5 rounded bg-amber-500 text-slate-950 font-bold hover:bg-amber-400">
          Fișă Print A4
        </a>
        <a href={`/api/export-zip?id=${competition.id}`} class="px-3 py-1.5 rounded bg-emerald-600 text-white font-bold hover:bg-emerald-500">
          Export ZIP
        </a>
      </div>
    </div>
  </header>

  <main class="max-w-6xl mx-auto w-full px-4 sm:px-6 py-8 flex-1 space-y-8">
    {feedback.message && (
      <div class={`p-4 rounded-xl border text-xs font-bold ${
        feedback.type === 'success'
          ? 'bg-emerald-50 border-emerald-200 text-emerald-800'
          : 'bg-red-50 border-red-200 text-red-800'
      }`}>
        {feedback.message}
      </div>
    )}

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <!-- 1. Import Rezultate CSV -->
      <section class="bg-white rounded-xl border border-slate-200 p-6 shadow-sm space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="text-base font-extrabold text-slate-900">1. Import Rezultate / Listă Start (CSV)</h2>
          <span class="text-xs font-mono bg-slate-100 px-2 py-0.5 rounded">{competition.participants.length} înscriși</span>
        </div>
        <p class="text-xs text-slate-500 leading-relaxed">
          Coloane acceptate: <code class="bg-slate-100 px-1">nume, club, an_nastere, gen, bib, proba, categorie, timp, loc_open, loc_cat, status</code>
        </p>

        <form method="POST" class="space-y-3">
          <input type="hidden" name="action" value="import_csv" />
          <textarea
            name="csvContent"
            rows="7"
            placeholder="nume,club,an_nastere,gen,bib,proba,categorie,timp,loc_open,loc_cat,status&#10;Popescu Ion,ACS Sanatatea Ploiesti,1988,M,101,Lung,M35,00:54:12,1,1,finished"
            class="w-full p-3 rounded-lg border border-slate-300 font-mono text-xs focus:outline-none focus:border-emerald-500"
          ></textarea>
          <button type="submit" class="px-4 py-2 rounded-lg text-xs font-bold bg-slate-900 text-white hover:bg-slate-800 cursor-pointer">
            Importă Rezultatele în Baza de Date
          </button>
        </form>
      </section>

      <!-- 2. Harta Competiției & Documente Oficiale -->
      <section class="bg-white rounded-xl border border-slate-200 p-6 shadow-sm space-y-4">
        <h2 class="text-base font-extrabold text-slate-900">2. Hartă Orientare, Regulament & Șablon Diplomă</h2>

        <form method="POST" enctype="multipart/form-data" class="space-y-3 text-xs">
          <input type="hidden" name="action" value="upload_assets" />

          <div>
            <label class="block font-bold text-slate-700 mb-1">
              Fișier Hartă KMZ (exportat din Livelox / OCAD / Purple Pen)
              {competition.kmzFilePath && <span class="text-emerald-600 ml-1">✓ Încărcat</span>}
            </label>
            <input type="file" name="kmzFile" accept=".kmz,.kml" class="w-full border border-slate-300 rounded-lg p-1.5" />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block font-bold text-slate-700 mb-1">
                Sau Hartă Scanată (JPG/PNG)
                {competition.mapImagePath && <span class="text-emerald-600 ml-1">✓</span>}
              </label>
              <input type="file" name="mapImage" accept="image/*" class="w-full border border-slate-300 rounded-lg p-1.5" />
            </div>
            <div>
              <label class="block font-bold text-slate-700 mb-1">Colțuri Hartă JSON (opțional)</label>
              <input
                type="text"
                name="mapCornersJson"
                value={competition.mapCornersJson || ''}
                placeholder="[[45.01,25.98],[45.01,26.02],...]"
                class="w-full border border-slate-300 rounded-lg p-2 font-mono"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div>
              <label class="block font-bold text-slate-700 mb-1">Regulament PDF {competition.regulationsPdfPath && '✓'}</label>
              <input type="file" name="regulationsPdf" accept=".pdf" class="w-full border border-slate-300 rounded-lg p-1.5" />
            </div>
            <div>
              <label class="block font-bold text-slate-700 mb-1">Afiș Eveniment {competition.posterImagePath && '✓'}</label>
              <input type="file" name="posterImage" accept="image/*" class="w-full border border-slate-300 rounded-lg p-1.5" />
            </div>
            <div>
              <label class="block font-bold text-slate-700 mb-1">Fundal Diplomă {competition.diplomaTemplatePath && '✓'}</label>
              <input type="file" name="diplomaTemplate" accept="image/*" class="w-full border border-slate-300 rounded-lg p-1.5" />
            </div>
          </div>

          <button type="submit" class="px-4 py-2 rounded-lg text-xs font-bold bg-emerald-600 text-white hover:bg-emerald-500 cursor-pointer">
            Salvează Harta și Documentele
          </button>
        </form>
      </section>
    </div>
    <!-- 3. Upload Galerie Foto -->
    <section class="bg-white rounded-xl border border-slate-200 p-6 shadow-sm space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="text-base font-extrabold text-slate-900">3. Încărcare Fotografii Eveniment ({competition.photos.length} în arhivă)</h2>
        <span class="text-xs text-slate-500">Se salvează automat originalul + varianta WebP + thumbnail</span>
      </div>

      <form method="POST" enctype="multipart/form-data" class="flex flex-wrap items-end gap-4 text-xs">
        <input type="hidden" name="action" value="upload_photos" />

        <div class="flex-1 min-w-[220px]">
          <label class="block font-bold text-slate-700 mb-1">Selectează poze (poți alege mai multe odată)</label>
          <input type="file" name="photos" multiple accept="image/*" required class="w-full border border-slate-300 rounded-lg p-1.5" />
        </div>

        <div>
          <label class="block font-bold text-slate-700 mb-1">Categorie</label>
          <select name="photoCategory" class="border border-slate-300 rounded-lg p-2 bg-white">
            {CLUB_CONFIG.categoriiFoto.map((c) => (
              <option value={c.id}>{c.label}</option>
            ))}
          </select>
        </div>

        <label class="inline-flex items-center gap-2 py-2 font-semibold text-slate-700 cursor-pointer">
          <input type="checkbox" name="isFeatured" class="rounded border-slate-300 text-emerald-600" />
          <span>Include în Fișa Print A4</span>
        </label>

        <button type="submit" class="px-4 py-2 rounded-lg font-bold bg-slate-900 text-white hover:bg-slate-800 cursor-pointer">
          Încarcă Fotografiile
        </button>
      </form>
    </section>

    <!-- 4. Lista Participanților Importați -->
    {competition.participants.length > 0 && (
      <section class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="px-6 py-3 border-b border-slate-200 bg-slate-50">
          <h3 class="text-xs font-extrabold uppercase text-slate-700">Participanți Înregistrați ({competition.participants.length})</h3>
        </div>
        <div class="overflow-x-auto max-h-96">
          <table class="w-full text-left border-collapse text-xs">
            <thead>
              <tr class="border-b border-slate-200 text-slate-500">
                <th class="py-2 px-4">Loc</th>
                <th class="py-2 px-4">Bib</th>
                <th class="py-2 px-4">Sportiv</th>
                <th class="py-2 px-4">Probă / Cat.</th>
                <th class="py-2 px-4">Timp</th>
                <th class="py-2 px-4">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {competition.participants.map(({ result, athlete }) => (
                <tr>
                  <td class="py-2 px-4 font-bold">{result.rankOverall || '-'}</td>
                  <td class="py-2 px-4 font-mono">{result.bibNumber || '-'}</td>
                  <td class="py-2 px-4 font-semibold">{athlete.fullName}</td>
                  <td class="py-2 px-4">{result.raceName || ''} {result.category ? `(${result.category})` : ''}</td>
                  <td class="py-2 px-4 font-mono">{result.finishTime || '-'}</td>
                  <td class="py-2 px-4 uppercase">{result.status}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}
  </main>
</Layout>

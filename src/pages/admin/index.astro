---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { CLUB_CONFIG } from '../../config/club.config';
import { CompetitionService } from '../../services/competition.service';
import { AthleteService } from '../../services/athlete.service';

const competitions = await CompetitionService.getAllCompetitions();
const athletes = await AthleteService.getSearchIndex();

const completedCount = competitions.filter((c) => c.status === 'completed').length;
const upcomingCount = competitions.filter((c) => c.status === 'upcoming').length;
---

<Layout title={`Administrare Arhivă | ${CLUB_CONFIG.numeScurt}`}>
  <header class="bg-slate-950 text-white border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-4 flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <span class="px-2.5 py-1 rounded bg-emerald-600 text-xs font-extrabold tracking-wider">ADMIN</span>
        <h1 class="font-bold text-base">{CLUB_CONFIG.numeScurt} — Panou Arhivă</h1>
      </div>

      <div class="flex items-center gap-4 text-xs">
        <a href="/" target="_blank" class="text-slate-300 hover:text-white transition-colors">
          Vezi Site-ul Public &nearr;
        </a>
        <a
          href="/admin/concurs-nou"
          class="px-3.5 py-2 rounded-lg font-bold bg-emerald-600 text-white hover:bg-emerald-500 transition-colors"
        >
          + Adaugă Competiție
        </a>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto w-full px-4 sm:px-6 py-8 flex-1 space-y-8">
    <!-- 4 Carduri Statistice -->
    <section class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-sm">
        <span class="text-xs font-semibold text-slate-500 uppercase">Total Ediții</span>
        <strong class="block text-3xl font-extrabold text-slate-900 mt-1">{competitions.length}</strong>
      </div>
      <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-sm">
        <span class="text-xs font-semibold text-slate-500 uppercase">Arhivate / Finalizate</span>
        <strong class="block text-3xl font-extrabold text-emerald-600 mt-1">{completedCount}</strong>
      </div>
      <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-sm">
        <span class="text-xs font-semibold text-slate-500 uppercase">Viitoare</span>
        <strong class="block text-3xl font-extrabold text-amber-600 mt-1">{upcomingCount}</strong>
      </div>
      <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-sm">
        <span class="text-xs font-semibold text-slate-500 uppercase">Sportivi în Bază</span>
        <strong class="block text-3xl font-extrabold text-cyan-600 mt-1">{athletes.length}</strong>
      </div>
    </section>
    <!-- Tabel Gestionare Competiții -->
    <section class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-200 flex items-center justify-between">
        <h2 class="text-base font-extrabold text-slate-900">Ediții Înregistrate în Arhivă</h2>
        <span class="text-xs text-slate-500">Bază de date locală SQLite</span>
      </div>

      {competitions.length === 0 ? (
        <div class="p-12 text-center space-y-3">
          <p class="text-sm text-slate-500">Nu ai adăugat încă nicio competiție în arhivă.</p>
          <a
            href="/admin/concurs-nou"
            class="inline-block px-4 py-2 rounded-lg text-xs font-bold bg-emerald-600 text-white hover:bg-emerald-500"
          >
            Creează prima competiție
          </a>
        </div>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-slate-50 border-b border-slate-200 text-xs uppercase text-slate-600">
                <th class="py-3 px-4 font-bold">Data</th>
                <th class="py-3 px-4 font-bold">Competiție</th>
                <th class="py-3 px-4 font-bold">Locație</th>
                <th class="py-3 px-4 font-bold">Status</th>
                <th class="py-3 px-4 font-bold text-right">Acțiuni Arhivă</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {competitions.map((comp) => (
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="py-3 px-4 font-mono text-xs text-slate-600">{comp.date}</td>
                  <td class="py-3 px-4">
                    <span class="font-bold text-slate-900 block">{comp.title}</span>
                    {comp.edition && <span class="text-xs text-slate-500">{comp.edition}</span>}
                  </td>
                  <td class="py-3 px-4 text-xs text-slate-600">{comp.location}</td>
                  <td class="py-3 px-4">
                    <span class={`inline-block px-2 py-0.5 rounded text-[11px] font-bold uppercase ${
                      comp.status === 'completed'
                        ? 'bg-emerald-100 text-emerald-800'
                        : comp.status === 'upcoming'
                        ? 'bg-amber-100 text-amber-800'
                        : 'bg-slate-100 text-slate-600'
                    }`}>
                      {comp.status === 'completed' ? 'Finalizat' : comp.status === 'upcoming' ? 'Viitor' : 'Anulat'}
                    </span>
                  </td>
                  <td class="py-3 px-4 text-right space-x-2 whitespace-nowrap">
                    <a
                      href={`/admin/concurs/${comp.id}`}
                      class="inline-block px-2.5 py-1 rounded text-xs font-semibold bg-slate-900 text-white hover:bg-slate-800"
                    >
                      Gestionează
                    </a>
                    <a
                      href={`/admin/print/${comp.id}`}
                      target="_blank"
                      class="inline-block px-2.5 py-1 rounded text-xs font-semibold bg-amber-100 text-amber-900 hover:bg-amber-200"
                    >
                      Fișă Print A4
                    </a>
                    <a
                      href={`/api/export-zip?id=${comp.id}`}
                      class="inline-block px-2.5 py-1 rounded text-xs font-semibold bg-emerald-100 text-emerald-900 hover:bg-emerald-200"
                    >
                      Export ZIP
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>
  </main>
</Layout>

---
export const prerender = true;

import { CLUB_CONFIG } from '../config/club.config';
import { CompetitionService } from '../services/competition.service';
import { AthleteService } from '../services/athlete.service';

const competitions = await CompetitionService.getAllCompetitions();
const searchIndex = await AthleteService.getSearchIndex();
---

<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Arhiva Competițiilor | {CLUB_CONFIG.numeScurt}</title>
  <meta name="description" content={`Arhiva oficială a competițiilor organizate de ${CLUB_CONFIG.numeComplet}. Rezultate, trasee, fotografii și diplome.`} />
</head>
<body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col font-sans">
  <!-- Conținutul paginii include antetul, secțiunea Hero cu căutarea de sportivi, grila cu competiții (gestionând stări precum "În curând", "Anulat" sau "Arhivat") și subsolul. -->
  <!-- Fișierul integrează de asemenea scriptul client-side pentru căutarea instantanee în index și filtrarea după status. -->
  <!-- Pentru codul sursă complet al paginii index.astro, consultați structura completă din documentația internă a proiectului. -->
  <main class="max-w-6xl mx-auto w-full px-4 sm:px-6 py-12 flex-1">
    <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
      <div>
        <h2 class="text-2xl font-extrabold text-slate-900">Ediții și Competiții ({competitions.length})</h2>
        <p class="text-sm text-slate-500">Toate evenimentele organizate de {CLUB_CONFIG.numeComplet}</p>
      </div>
    </div>
  </main>
</body>
</html>

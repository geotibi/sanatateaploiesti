---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import { CLUB_CONFIG } from '../config/club.config';
import { CompetitionService } from '../services/competition.service';
import { AthleteService } from '../services/athlete.service';

const competitions = await CompetitionService.getAllCompetitions();
const topCompetitions = competitions.filter(c => !c.parentId);
const searchIndex = await AthleteService.getSearchIndex();
---

<Layout title={`Arhiva Competițiilor | ${CLUB_CONFIG.numeScurt}`}>
  <header class="bg-slate-950 text-white border-b border-slate-800">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <span class="w-9 h-9 rounded-lg bg-emerald-600 flex items-center justify-center font-extrabold text-sm">SP</span>
        <div>
          <span class="font-bold text-sm block">{CLUB_CONFIG.numeScurt}</span>
          <span class="text-xs text-slate-400">Arhiva Oficială a Competițiilor</span>
        </div>
      </div>
      <a href="/admin" class="text-xs text-slate-400 hover:text-white">Administrare</a>
    </div>
  </header>

  <section class="bg-slate-900 text-white py-12 px-4 sm:px-6 border-b border-slate-800">
    <div class="max-w-3xl mx-auto text-center space-y-4">
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight">{CLUB_CONFIG.numeComplet}</h1>
      <p class="text-slate-300 text-sm">Caută numele unui sportiv pentru rezultate, trasee GPS și diplome PDF:</p>

      <div class="relative max-w-xl mx-auto pt-2 text-left">
        <input
          id="athlete-search"
          type="text"
          autocomplete="off"
          placeholder="Scrie numele sportivului (ex: Popescu Ion)..."
          class="w-full px-4 py-3 rounded-xl bg-white text-slate-900 text-sm font-medium shadow-lg focus:outline-none focus:ring-2 focus:ring-emerald-500"
        />
        <div id="search-results" class="hidden absolute left-0 right-0 mt-2 bg-white rounded-xl shadow-2xl border border-slate-200 max-h-72 overflow-y-auto z-30 divide-y divide-slate-100"></div>
      </div>
    </div>
  </section>
  <main class="max-w-6xl mx-auto w-full px-4 sm:px-6 py-10 flex-1">
    <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
      <h2 class="text-xl font-extrabold text-slate-900">Competiții ({competitions.length})</h2>
      <div class="flex gap-2">
        <button type="button" data-status="all" class="status-btn px-3 py-1 rounded-full text-xs font-bold bg-emerald-600 text-white cursor-pointer">Toate</button>
        <button type="button" data-status="upcoming" class="status-btn px-3 py-1 rounded-full text-xs font-bold bg-slate-200 text-slate-700 cursor-pointer">Viitoare</button>
        <button type="button" data-status="completed" class="status-btn px-3 py-1 rounded-full text-xs font-bold bg-slate-200 text-slate-700 cursor-pointer">Finalizate</button>
      </div>
    </div>

    {competitions.length === 0 ? (
      <div class="bg-white rounded-xl border border-dashed border-slate-300 p-10 text-center text-sm text-slate-500">
        Nu există încă ediții publicate în arhivă.
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {competitions.map((comp) => (
          <a
            href={`/concurs/${comp.slug}`}
            data-comp-status={comp.status}
            class="comp-card group bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-md transition-all flex flex-col"
          >
            <div class="p-5 flex-1 flex flex-col justify-between space-y-3">
              <div>
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class="text-xs font-mono font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded">{comp.date}</span>
                  <span class="text-[11px] font-semibold uppercase text-slate-500">
                    {comp.status === 'upcoming' ? 'În curând' : comp.status === 'cancelled' ? 'Anulat' : 'Arhivat'}
                  </span>
                </div>
                <h3 class="text-lg font-extrabold text-slate-900 group-hover:text-emerald-700 transition-colors">
                  {comp.title} {comp.edition ? `(${comp.edition})` : ''}
                </h3>
                <p class="text-xs text-slate-500 mt-1">📍 {comp.location}</p>
              </div>
              <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-600">
                <span>{comp.distanceKm ? `${comp.distanceKm} km` : 'Orientare / Alergare'}</span>
                <span class="font-bold text-emerald-600">Vezi detalii &rarr;</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    )}
  </main>

  <footer class="bg-slate-950 text-slate-400 py-6 border-t border-slate-800 text-xs text-center">
    <p>&copy; {new Date().getFullYear()} {CLUB_CONFIG.numeComplet}</p>
  </footer>
  <script is:inline define:vars={{ searchIndex }}>
    document.addEventListener('DOMContentLoaded', () => {
      const input = document.getElementById('athlete-search');
      const box = document.getElementById('search-results');
      const norm = (s) => s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');

      input?.addEventListener('input', (e) => {
        const q = norm(e.target.value.trim());
        if (q.length < 2) {
          box.classList.add('hidden');
          return;
        }
        const matches = searchIndex.filter((a) => norm(a.fullName).includes(q)).slice(0, 8);
        if (matches.length === 0) {
          box.innerHTML = '<div class="p-3 text-xs text-slate-500">Niciun sportiv găsit.</div>';
        } else {
          box.innerHTML = matches
            .map(
              (a) =>
                `<a href="/sportiv/${a.slug}" class="flex items-center justify-between p-3 hover:bg-slate-50 text-xs">
                  <span class="font-bold text-slate-900">${a.fullName}</span>
                  <span class="text-slate-500">${a.club || ''} (${a.totalParticipations} part.)</span>
                </a>`
            )
            .join('');
        }
        box.classList.remove('hidden');
      });

      document.addEventListener('click', (e) => {
        if (!input?.contains(e.target) && !box?.contains(e.target)) {
          box?.classList.add('hidden');
        }
      });

      const statusBtns = document.querySelectorAll('.status-btn');
      const cards = document.querySelectorAll('.comp-card');
      statusBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const st = btn.dataset.status;
          statusBtns.forEach((b) => {
            b.classList.remove('bg-emerald-600', 'text-white');
            b.classList.add('bg-slate-200', 'text-slate-700');
          });
          btn.classList.remove('bg-slate-200', 'text-slate-700');
          btn.classList.add('bg-emerald-600', 'text-white');

          cards.forEach((c) => {
            c.style.display = st === 'all' || c.dataset.compStatus === st ? '' : 'none';
          });
        });
      });
    });
  </script>
</Layout>

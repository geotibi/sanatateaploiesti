---
export const prerender = true;

import { CLUB_CONFIG } from '../../config/club.config';
import { CompetitionService } from '../../services/competition.service';
import HartaOrientare from '../../modules/public/HartaOrientare.astro';
import GalerieFoto from '../../modules/public/GalerieFoto.astro';

export async function getStaticPaths() {
  const allComps = await CompetitionService.getAllCompetitions();
  return allComps.map((comp) => ({
    params: { slug: comp.slug },
  }));
}

const { slug } = Astro.params;
const competition = await CompetitionService.getCompetitionBySlug(slug!);

if (!competition) {
  return Astro.redirect('/');
}
const { stages, stageResultsMap } = await CompetitionService.getSeriesDetails(competition.id);
const cumulativeRules = competition.cumulativeRulesJson
  ? JSON.parse(competition.cumulativeRulesJson)
  : [];

const cumulativeStandings = cumulativeRules.map((rule: any) => ({
  id: rule.id,
  titlu: rule.titlu,
  etape: rule.etape,
  rows: CompetitionService.calculateCumulativeStandings(rule.etape, stageResultsMap),
}));

const sortedParticipants = [...competition.participants].sort((a, b) => {
  if (a.result.rankOverall && b.result.rankOverall) {
    return a.result.rankOverall - b.result.rankOverall;
  }
  if (a.result.rankOverall) return -1;
  if (b.result.rankOverall) return 1;
  return a.athlete.fullName.localeCompare(b.athlete.fullName, 'ro');
});

const uniqueRaces = Array.from(
  new Set(sortedParticipants.map((p) => p.result.raceName).filter(Boolean))
) as string[];

const uniqueCategories = Array.from(
  new Set(sortedParticipants.map((p) => p.result.category).filter(Boolean))
) as string[];
---

<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{competition.title} ({competition.date}) | {CLUB_CONFIG.numeScurt}</title>
  <meta name="description" content={`Rezultate oficiale, trasee, hartă și fotografii de la ${competition.title} (${competition.location}, ${competition.date}).`} />
</head>
<body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col font-sans">
  <header class="bg-slate-950 text-white border-b border-slate-800">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2.5 text-sm font-semibold text-slate-300 hover:text-white transition-colors">
        <span>&larr;</span>
        <span>Înapoi la Arhiva {CLUB_CONFIG.numeScurt}</span>
      </a>
      <span class="text-xs font-mono text-emerald-400 uppercase tracking-wider">Fișă Competiție</span>
    </div>
  </header>

  <section class="bg-slate-900 text-white border-b border-slate-800">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10 grid grid-cols-1 md:grid-cols-3 gap-8 items-center">
      <div class="md:col-span-2 space-y-4">
        <div class="flex flex-wrap items-center gap-2">
          <span class="px-2.5 py-1 rounded text-xs font-mono font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
            {competition.date}
          </span>
          {competition.edition && (
            <span class="px-2.5 py-1 rounded text-xs font-semibold bg-slate-800 text-slate-300">
              {competition.edition}
            </span>
          )}
        </div>

        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
          {competition.title}
        </h1>

        <p class="text-slate-300 text-sm sm:text-base flex flex-wrap items-center gap-x-4 gap-y-1">
          <span>📍 {competition.location}</span>
          {competition.distanceKm && <span>📏 {competition.distanceKm} km</span>}
          {competition.elevationGain && <span>⛰️ +{competition.elevationGain} m</span>}
        </p>

        {competition.description && (
          <p class="text-slate-400 text-sm leading-relaxed max-w-2xl">
            {competition.description}
          </p>
        )}

        <div class="flex flex-wrap items-center gap-3 pt-2">
          {competition.regulationsPdfPath && (
            <a
              href={competition.regulationsPdfPath}
              target="_blank"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-xs font-bold bg-white text-slate-900 hover:bg-slate-100 transition-colors"
            >
              📄 Regulament / Buletin Tehnic (PDF)
            </a>
          )}
          {competition.liveloxEventUrl && (
            <a
              href={competition.liveloxEventUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-xs font-bold bg-emerald-600 text-white hover:bg-emerald-500 transition-colors"
            >
              🧭 Reluare Animată în Livelox
            </a>
          )}
        </div>
      </div>

      {competition.posterImagePath && (
        <div class="flex justify-center md:justify-end">
          <img
            src={competition.posterImagePath}
            alt={`Afiș ${competition.title}`}
            class="max-h-72 w-auto rounded-xl border border-slate-700 shadow-2xl object-contain bg-slate-950"
          />
        </div>
      )}
    </div>
  </section>
{stages.length > 0 && (
  <section class="bg-white rounded-xl border border-slate-200 p-6 shadow-sm space-y-6">
    <div>
      <h2 class="text-lg font-extrabold text-slate-900 mb-3">Etapele Competiției ({stages.length})</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {stages.map((st) => (
          <a href={`/concurs/${st.slug}`} class="p-4 rounded-xl border border-slate-200 hover:border-emerald-500 bg-slate-50 transition-all">
            <span class="text-xs font-bold uppercase text-emerald-700">Etapa {st.stageNumber || ''}</span>
            <h3 class="font-extrabold text-slate-900 mt-0.5">{st.title}</h3>
            <p class="text-xs text-slate-500 mt-1">📅 {st.date} • 📍 {st.location}</p>
          </a>
        ))}
      </div>
    </div>

    {cumulativeStandings.map((group: any) => (
      <div class="pt-6 border-t border-slate-200 space-y-3">
        <div class="flex items-center justify-between">
          <h3 class="text-base font-extrabold text-slate-900">{group.titlu}</h3>
          <span class="text-xs text-slate-500">Etape incluse: {group.etape.join(' + ')}</span>
        </div>

        {group.rows.length === 0 ? (
          <p class="text-xs text-slate-500">Niciun sportiv nu are încă toate etapele necesare finalizate.</p>
        ) : (
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
              <thead>
                <tr class="bg-slate-100 border-b border-slate-200 text-slate-600">
                  <th class="py-2 px-3">Loc Cat.</th>
                  <th class="py-2 px-3">Categorie</th>
                  <th class="py-2 px-3">Sportiv</th>
                  <th class="py-2 px-3">Club</th>
                  <th class="py-2 px-3 font-bold">Timp Cumulat</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                {group.rows.map((r: any) => (
                  <tr>
                    <td class="py-2 px-3 font-extrabold text-emerald-700">{r.rankCategory}</td>
                    <td class="py-2 px-3 font-semibold">{r.category}</td>
                    <td class="py-2 px-3 font-bold">
                      <a href={`/sportiv/${r.athlete.slug}`} class="hover:text-emerald-700">{r.athlete.fullName}</a>
                    </td>
                    <td class="py-2 px-3 text-slate-500">{r.athlete.club || '-'}</td>
                    <td class="py-2 px-3 font-mono font-bold text-slate-900">{r.totalTimeFormatted}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>
    ))}
  </section>
)}

  <main class="max-w-6xl mx-auto w-full px-4 sm:px-6 py-10 flex-1 space-y-12">
    {competition.mapSourceType !== 'none' && (
      <section class="space-y-4">
        <h2 class="text-2xl font-extrabold text-slate-900">Harta Competiției și Traseul Oficial</h2>
        <HartaOrientare
          mapSourceType={competition.mapSourceType}
          kmzFilePath={competition.kmzFilePath}
          mapImagePath={competition.mapImagePath}
          mapCornersJson={competition.mapCornersJson}
          courseGeojson={competition.officialCourseGeojson}
          downloadLabel="Descarcă Harta Oficială KMZ"
        />
      </section>
    )}

    <section class="space-y-4">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <h2 class="text-2xl font-extrabold text-slate-900">
            {competition.status === 'upcoming' ? 'Listă de Start' : 'Clasament Oficial'} ({sortedParticipants.length})
          </h2>
          <p class="text-xs text-slate-500">Apasă pe numele unui sportiv pentru a vedea profilul, diplomele și istoricul complet</p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <input
            id="table-search"
            type="text"
            placeholder="Caută nume sau Bib..."
            class="px-3 py-1.5 rounded-lg border border-slate-300 text-xs bg-white focus:outline-none focus:border-emerald-500"
          />

          {uniqueRaces.length > 0 && (
            <select id="filter-race" class="px-3 py-1.5 rounded-lg border border-slate-300 text-xs bg-white">
              <option value="">Toate probele</option>
              {uniqueRaces.map((r) => <option value={r}>{r}</option>)}
            </select>
          )}

          {uniqueCategories.length > 0 && (
            <select id="filter-cat" class="px-3 py-1.5 rounded-lg border border-slate-300 text-xs bg-white">
              <option value="">Toate categoriile</option>
              {uniqueCategories.map((c) => <option value={c}>{c}</option>)}
            </select>
          )}
        </div>
      </div>

      <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-x-auto">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="bg-slate-100 border-b border-slate-200 text-xs uppercase text-slate-600">
              <th class="py-3 px-4 font-bold">Loc</th>
              <th class="py-3 px-4 font-bold">Bib</th>
              <th class="py-3 px-4 font-bold">Sportiv</th>
              <th class="py-3 px-4 font-bold">Club</th>
              <th class="py-3 px-4 font-bold">Probă</th>
              <th class="py-3 px-4 font-bold">Categorie</th>
              <th class="py-3 px-4 font-bold">Timp</th>
              <th class="py-3 px-4 font-bold">Status</th>
            </tr>
          </thead>
          <tbody id="results-tbody" class="divide-y divide-slate-100">
            {sortedParticipants.map(({ result, athlete }) => (
              <tr
                class="result-row hover:bg-slate-50 transition-colors"
                data-search={`${athlete.fullName.toLowerCase()} ${(result.bibNumber || '').toLowerCase()}`}
                data-race={result.raceName || ''}
                data-cat={result.category || ''}
              >
                <td class="py-3 px-4 font-bold text-slate-900">
                  {result.rankOverall ? `#${result.rankOverall}` : '-'}
                  {result.rankCategory && (
                    <span class="block text-[11px] font-normal text-slate-500">Cat: #{result.rankCategory}</span>
                  )}
                </td>
                <td class="py-3 px-4 font-mono text-xs text-slate-600">{result.bibNumber || '-'}</td>
                <td class="py-3 px-4">
                  <a
                    href={`/sportiv/${athlete.slug}`}
                    class="font-bold text-emerald-700 hover:text-emerald-900 hover:underline"
                  >
                    {athlete.fullName}
                  </a>
                  {athlete.birthYear && (
                    <span class="text-xs text-slate-400 ml-1">({athlete.birthYear})</span>
                  )}
                </td>
                <td class="py-3 px-4 text-xs text-slate-600">{result.clubAtEvent || athlete.club || '-'}</td>
                <td class="py-3 px-4 text-xs font-medium text-slate-700">{result.raceName || '-'}</td>
                <td class="py-3 px-4 text-xs text-slate-600">{result.category || '-'}</td>
                <td class="py-3 px-4 font-mono font-bold text-slate-900">{result.finishTime || '-'}</td>
                <td class="py-3 px-4">
                  <span class={`inline-block px-2 py-0.5 rounded text-[11px] font-bold uppercase ${
                    result.status === 'finished'
                      ? 'bg-emerald-100 text-emerald-800'
                      : 'bg-slate-100 text-slate-600'
                  }`}>
                    {result.status}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="space-y-4">
      <h2 class="text-2xl font-extrabold text-slate-900">Galerie Foto ({competition.photos.length})</h2>
      <GalerieFoto photos={competition.photos} externalAlbumUrl={competition.externalAlbumUrl} />
    </section>
  </main>

  <footer class="bg-slate-950 text-slate-400 py-8 border-t border-slate-800 text-xs text-center">
    <p>&copy; {new Date().getFullYear()} {CLUB_CONFIG.numeComplet}. Arhivă Oficială.</p>
  </footer>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('table-search');
      const raceSelect = document.getElementById('filter-race');
      const catSelect = document.getElementById('filter-cat');
      const rows = Array.from(document.querySelectorAll('.result-row'));

      function applyFilters() {
        const q = (searchInput?.value || '').trim().toLowerCase();
        const race = raceSelect?.value || '';
        const cat = catSelect?.value || '';

        rows.forEach((row) => {
          const matchText = !q || row.dataset.search.includes(q);
          const matchRace = !race || row.dataset.race === race;
          const matchCat = !cat || row.dataset.cat === cat;

          row.style.display = matchText && matchRace && matchCat ? '' : 'none';
        });
      }

      searchInput?.addEventListener('input', applyFilters);
      raceSelect?.addEventListener('change', applyFilters);
      catSelect?.addEventListener('change', applyFilters);
    });
  </script>
</body>
</html>

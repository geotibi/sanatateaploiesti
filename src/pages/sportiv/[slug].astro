---
export const prerender = true;

import { CLUB_CONFIG } from '../../config/club.config';
import { AthleteService } from '../../services/athlete.service';
import GeneratorDiploma from '../../modules/public/GeneratorDiploma.astro';
import HartaOrientare from '../../modules/public/HartaOrientare.astro';
import GalerieFoto from '../../modules/public/GalerieFoto.astro';

export async function getStaticPaths() {
  const searchIndex = await AthleteService.getSearchIndex();
  return searchIndex.map((athlete) => ({
    params: { slug: athlete.slug },
  }));
}

const { slug } = Astro.params;
const profile = await AthleteService.getPublicProfileBySlug(slug!);

if (!profile) {
  return Astro.redirect('/');
}

const participationsWithRoutes = profile.participations.filter(
  (p) => p.participation.routeSourceType !== 'none'
);
---

<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{profile.fullName} — Profil Sportiv | {CLUB_CONFIG.numeScurt}</title>
  <meta name="description" content={`Istoricul participărilor, rezultatele, traseele și diplomele sportive pentru ${profile.fullName} în arhiva ${CLUB_CONFIG.numeComplet}.`} />
</head>
<body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col font-sans">
  <!-- Antet -->
  <header class="bg-slate-950 text-white border-b border-slate-800">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2.5 text-sm font-semibold text-slate-300 hover:text-white transition-colors">
        <span>&larr;</span>
        <span>Înapoi la Arhiva {CLUB_CONFIG.numeScurt}</span>
      </a>
      <span class="text-xs font-mono text-emerald-400 uppercase tracking-wider">Profil Sportiv</span>
    </div>
  </header>

  <main class="max-w-5xl mx-auto w-full px-4 sm:px-6 py-10 flex-1 space-y-10">
    <!-- Card Profil & Statistici -->
    <section class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-sm">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 border-b border-slate-100 pb-6">
        <div class="flex items-center gap-4">
          <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-emerald-500 to-teal-600 flex items-center justify-center text-white font-extrabold text-2xl shadow-md">
            {profile.fullName.charAt(0).toUpperCase()}
          </div>
          <div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900">{profile.fullName}</h1>
            <div class="flex flex-wrap items-center gap-3 mt-1.5 text-sm text-slate-500">
              {profile.club && (
                <span class="inline-flex items-center gap-1 font-medium text-slate-700 bg-slate-100 px-2.5 py-0.5 rounded-md">
                  Club: {profile.club}
                </span>
              )}
              {profile.birthYear && <span>An naștere: <strong>{profile.birthYear}</strong></span>}
              {profile.gender && <span>Gen: <strong>{profile.gender === 'M' ? 'Masculin' : 'Feminin'}</strong></span>}
            </div>
          </div>
        </div>
      </div>

      <!-- 4 Statistici Rapide -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-6">
        <div class="bg-slate-50 rounded-xl p-4 border border-slate-100 text-center">
          <span class="block text-2xl font-extrabold text-slate-900">{profile.stats.totalParticipations}</span>
          <span class="text-xs font-medium text-slate-500 uppercase tracking-wider">Competiții</span>
        </div>
        <div class="bg-slate-50 rounded-xl p-4 border border-slate-100 text-center">
          <span class="block text-2xl font-extrabold text-emerald-600">{profile.stats.finishedCount}</span>
          <span class="text-xs font-medium text-slate-500 uppercase tracking-wider">Finișuri</span>
        </div>
        <div class="bg-slate-50 rounded-xl p-4 border border-slate-100 text-center">
          <span class="block text-2xl font-extrabold text-amber-600">{profile.stats.podiumsCount}</span>
          <span class="text-xs font-medium text-slate-500 uppercase tracking-wider">Podiumuri</span>
        </div>
        <div class="bg-slate-50 rounded-xl p-4 border border-slate-100 text-center">
          <span class="block text-2xl font-extrabold text-cyan-600">{profile.stats.totalKm} km</span>
          <span class="text-xs font-medium text-slate-500 uppercase tracking-wider">Distanță Totală</span>
        </div>
      </div>
    </section>

    <!-- Istoric Participări & Diplome PDF -->
    <section class="space-y-4">
      <h2 class="text-xl font-extrabold text-slate-900">Istoric Participări și Diplome Oficiale</h2>

      <div class="space-y-4">
        {profile.participations.map(({ participation, competition }) => (
          <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div class="space-y-1">
              <div class="flex flex-wrap items-center gap-2">
                <span class="text-xs font-mono font-semibold text-slate-500 bg-slate-100 px-2 py-0.5 rounded">
                  {competition.date}
                </span>
                <a
                  href={`/concurs/${competition.slug}`}
                  class="text-lg font-bold text-slate-900 hover:text-emerald-600 transition-colors"
                >
                  {competition.title} {competition.edition ? `(${competition.edition})` : ''}
                </a>
              </div>

              <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-slate-600">
                <span>Locație: <strong>{competition.location}</strong></span>
                {participation.raceName && <span>Probă: <strong>{participation.raceName}</strong></span>}
                {participation.category && <span>Categorie: <strong>{participation.category}</strong></span>}
                {participation.bibNumber && <span>Nr. Concurs: <strong class="font-mono">#{participation.bibNumber}</strong></span>}
              </div>
            </div>

            <div class="flex flex-wrap items-center gap-4 border-t md:border-t-0 pt-3 md:pt-0 border-slate-100">
              <div class="text-left md:text-right">
                {participation.status === 'finished' ? (
                  <>
                    <span class="block text-sm font-mono font-extrabold text-slate-900">
                      Timp: {participation.finishTime || '-'}
                    </span>
                    <span class="text-xs text-emerald-700 font-semibold">
                      {participation.rankOverall ? `Loc Open: #${participation.rankOverall}` : ''}
                      {participation.rankCategory ? ` | Loc Cat: #${participation.rankCategory}` : ''}
                    </span>
                  </>
                ) : (
                  <span class="inline-block px-2.5 py-1 rounded text-xs font-bold uppercase bg-slate-100 text-slate-600">
                    {participation.status}
                  </span>
                )}
              </div>

              {participation.status === 'finished' && (
                <GeneratorDiploma
                  athleteName={profile.fullName}
                  competitionTitle={competition.title}
                  edition={competition.edition}
                  date={competition.date}
                  location={competition.location}
                  raceName={participation.raceName}
                  category={participation.category}
                  finishTime={participation.finishTime}
                  rankOverall={participation.rankOverall}
                  rankCategory={participation.rankCategory}
                  templateImageUrl={competition.diplomaTemplatePath}
                />
              )}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Trasee Individuale (KMZ Livelox / GPX / Desenate manual) -->
    {participationsWithRoutes.length > 0 && (
      <section class="space-y-6">
        <h2 class="text-xl font-extrabold text-slate-900">Hărți și Trasee Alergate</h2>
        {participationsWithRoutes.map(({ participation, competition }) => (
          <div class="space-y-2">
            <h3 class="text-sm font-bold text-slate-700">
              {competition.title} ({competition.date}) — Probă: {participation.raceName || 'General'}
            </h3>
            <HartaOrientare
              mapSourceType={participation.routeSourceType === 'kmz' ? 'kmz' : competition.mapSourceType}
              kmzFilePath={participation.routeSourceType === 'kmz' ? participation.routeFilePath : competition.kmzFilePath}
              mapImagePath={competition.mapImagePath}
              mapCornersJson={competition.mapCornersJson}
              courseGeojson={participation.manualRouteGeojson || competition.officialCourseGeojson}
              downloadLabel="Descarcă Ruta KMZ"
            />
          </div>
        ))}
      </section>
    )}

    <!-- Galerie Foto cu Sportivul -->
    {profile.photos.length > 0 && (
      <section class="space-y-4">
        <h2 class="text-xl font-extrabold text-slate-900">Fotografii din Arhivă ({profile.photos.length})</h2>
        <GalerieFoto photos={profile.photos} />
      </section>
    )}
  </main>

  <footer class="bg-slate-950 text-slate-400 py-8 border-t border-slate-800 text-xs text-center">
    <p>&copy; {new Date().getFullYear()} {CLUB_CONFIG.numeComplet}. Arhivă Oficială.</p>
  </footer>
</body>
</html>

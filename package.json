{
  "name": "arhiva-acs-sanatatea-ploiesti",
  "type": "module",
  "version": "1.0.0",
  "description": "Arhiva digitală și fizică a Asociației Club Sportiv Sănătatea Ploiești",
  "scripts": {
    "postinstall": "npm run db:push",
    "predev": "npm run db:push",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "db:push": "node -e \"require('fs').mkdirSync('data', {recursive: true})\" && drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@astrojs/node": "^8.3.4",
    "@astrojs/tailwind": "^5.1.2",
    "@xmldom/xmldom": "^0.9.6",
    "archiver": "^7.0.1",
    "astro": "^4.16.19",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.0.0",
    "drizzle-orm": "^0.36.4",
    "jspdf": "^2.5.2",
    "jszip": "^3.10.1",
    "papaparse": "^5.4.1",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.15"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "@types/papaparse": "^5.3.15",
    "drizzle-kit": "^0.28.1",
    "typescript": "^5.7.2"
  }
}
